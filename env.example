# Server-side API keys
# ---------------------------------------------------------------
# These have NO "VITE_" prefix on purpose: VITE_ variables are bundled into
# the browser JavaScript where anyone can read them. These keys are only read
# by the /api proxy (server/apiProxy.ts) - in `npm run dev` / `npm run preview`
# and in the Vercel serverless function (api/proxy.ts).
# On Vercel, add them under Project Settings -> Environment Variables.

# OpenRouter API key - get a free one from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: comma-separated OpenRouter models, tried in order (default: openrouter/free and two free fallbacks)
# OPENROUTER_MODELS=openrouter/free,google/gemma-4-31b-it:free

# Optional: Google Gemini API Key (for direct Gemini access)
# Generate one from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: comma-separated Gemini models, tried in order
# (default: gemini-flash-latest,gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# Optional: Deepgram TTS API Key (for enhanced voice quality)
# Get your free API key from: https://deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional: Hugging Face token (for sentiment analysis; falls back to a local heuristic)
# Get one from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Plugin API Keys (Optional - add as needed)
# Weather Plugin - Get free API key from: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# News Plugin - Get free API key from: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# Web Search Plugin - Get free API key from: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# YouTube Plugin - Get free API key from: https://developers.google.com/youtube/v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Browser control (local only; uses GEMINI_API_KEY and installed Google Chrome)
# Optional: comma-separated Gemini models for the browser agent, tried in order
# BROWSER_AGENT_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# Optional: Chrome profile folder for the agent (default: ~/.lexi/browser-profile)
# BROWSER_PROFILE_DIR=
